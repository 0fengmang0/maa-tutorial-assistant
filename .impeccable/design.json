  "narrative": {
    "northStar": "MAA 深色任务面板",
    "overview": "继承用户指定 MAA 截图的原生深色桌面界面。深灰底色、细边框、蓝色强调和紧凑任务布局服务于本地任务的选择、说明阅读和运行反馈；本轮在既有视觉世界中将主窗口改为三栏。\n\n实际实现使用 Windows WPF 与 HandyControl 3.5.1，加载其 `SkinDark.xaml` 和 `Theme.xaml`。规范以 `src/MainWindow.xaml`、`src/MainWindow.xaml.cs` 和 `src/App.cs` 的当前实现为依据；未覆写的窗口、复选框、菜单及文本框细节仍继承当前原生主题。没有新字体资产、MAA Logo 或官方代码复用。",
    "keyCharacteristics": [
      "深色平面容器，以细灰边框划分任务、字段、日志与状态。",
      "蓝色用于选中齿轮、分段标签与键盘焦点，运行结果由文字表达。",
      "紧凑中文桌面文字，围绕两项真实任务组织选择、详情和日志。"
    ],
    "rules": [
      {
        "name": "The Restrained Accent Rule",
        "body": "用文字表达完成、停止与失败；不要给每种运行状态新增一套强调色。",
        "section": "colors"
      },
      {
        "name": "The Native Density Rule",
        "body": "保持系统中文桌面文字的紧凑密度，用区域、留白和状态表达层级，不以装饰标题扩大界面。",
        "section": "typography"
      },
      {
        "name": "The Three Regions Rule",
        "body": "任务选择留在左侧，所选任务详情留在中间，日志和主状态留在右侧；切换任务不改变三个区域的位置。",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** 保留原生深色任务面板、浅色正文与稀疏蓝色强调。",
      "**Do** 保留任务勾选与详情选择的不同职责，以及详情和当前任务日志的同步切换。",
      "**Do** 保留可滚动说明、可选择日志和自定义控件的键盘焦点反馈。",
      "**Do** 分别记录功能验收、用户界面验收和独立视觉审阅的实际覆盖范围。"
    ],
    "donts": [
      "**Don't** 使用 MAA Logo、复制其官方代码或宣称官方关系。",
      "**Don't** 添加无真实功能的分页，或把轻量两任务范围扩成新的工作台。",
      "**Don't** 把旧版截图、HTML 预览或用户收尾确认写成新版独立视觉审阅结论。",
      "**Don't** 将单一环境的结果推广为所有运行状态、DPI、语言或 MAA 版本均已通过。"
    ]
  }
}
