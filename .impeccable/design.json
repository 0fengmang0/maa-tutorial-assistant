    {
      "name": "任务详情选择器",
      "kind": "custom",
      "refersTo": "task-selector",
      "description": "复选框负责执行范围，名称与齿轮负责详情选择；仅展示控件样式，HTML预览不执行WPF任务。",
      "html": "<div class=\"ds-task-row\"><input class=\"ds-task-enable\" type=\"checkbox\" checked aria-label=\"启用通过 MAA 新手教程任务\"><label class=\"ds-task-label\"><input class=\"ds-task-radio\" type=\"radio\" name=\"ds-task\" checked><span class=\"ds-task-selector\"><span>通过 MAA 新手教程</span><svg class=\"ds-task-gear\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M10,1 H14 L14.7,4.1 L16.1,4.7 L18.8,3.1 L21.6,5.9 L20,8.6 L20.6,10 H23 V14 H20.6 L20,15.4 L21.6,18.1 L18.8,20.9 L16.1,19.3 L14.7,19.9 L14,23 H10 L9.3,19.9 L7.9,19.3 L5.2,20.9 L2.4,18.1 L4,15.4 L3.4,14 H1 V10 H3.4 L4,8.6 L2.4,5.9 L5.2,3.1 L7.9,4.7 L9.3,4.1 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z\" fill-rule=\"evenodd\"/></svg></span></label></div>",
      "css": ".ds-task-row{display:grid;grid-template-columns:24px 1fr;align-items:center;background:#1C1C1C;font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#EEEEEE}.ds-task-enable{color-scheme:dark;accent-color:#008DDB}.ds-task-label{position:relative;cursor:pointer}.ds-task-radio{position:absolute;opacity:0;width:1px;height:1px}.ds-task-selector{display:grid;grid-template-columns:1fr 24px;align-items:center;height:32px;border:1px solid transparent;border-radius:2px;padding:0 4px}.ds-task-gear{fill:transparent;stroke:#888888;stroke-width:1.1}.ds-task-radio:checked+.ds-task-selector .ds-task-gear{fill:#008DDB;stroke:#008DDB}.ds-task-label:hover .ds-task-selector{background:#262626}.ds-task-radio:focus-visible+.ds-task-selector{border-color:#008DDB}"
    },
