      "html": "<div class=\"ds-segments\" role=\"group\" aria-label=\"任务说明\"><label class=\"ds-segment-label\"><input class=\"ds-segment-input\" type=\"radio\" name=\"ds-detail-tab\" checked><span class=\"ds-segment\">常规设置</span></label><label class=\"ds-segment-label\"><input class=\"ds-segment-input\" type=\"radio\" name=\"ds-detail-tab\"><span class=\"ds-segment\">高级设置</span></label></div>",
