<Project>
  <PropertyGroup>
    <MaaScratch Condition="'$(MaaScratch)' == ''">$([System.IO.Path]::GetTempPath())maa-tutorial-assistant-build</MaaScratch>
    <BaseIntermediateOutputPath>$(MaaScratch)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MaaScratch)\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
