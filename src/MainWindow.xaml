<hc:Window x:Class="MaaTutorialAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="MAA 教程助手" Width="800" Height="600" MinWidth="720" MinHeight="500"
    WindowStartupLocation="CenterScreen" Background="#1C1C1C" Foreground="#EEEEEE">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
    <Border BorderBrush="#178DD4" BorderThickness="0,0,0,1"><TextBlock Text="教程助手" Margin="12,8" FontSize="15" Foreground="#49ABDF"/></Border>
    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <Border BorderBrush="#414141" BorderThickness="1" CornerRadius="3" Padding="12"><StackPanel><TextBlock Text="通过 MAA 新手教程"/><TextBlock x:Name="TutorialStatus" Text="等待执行" Margin="0,6,0,0" Foreground="#B3B3B3" FontSize="12"/></StackPanel></Border>
        <Border x:Name="RestoreRow" Visibility="Collapsed" BorderBrush="#414141" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,8,0,0"><StackPanel><TextBlock Text="恢复原主题"/><TextBlock x:Name="RestoreStatus" Text="等待教程完成" Margin="0,6,0,0" Foreground="#B3B3B3" FontSize="12"/></StackPanel></Border>
        <Button x:Name="AddButton" Margin="0,12,0,0" Height="34" Click="AddTask" ToolTip="添加任务">
          <Button.ContextMenu><ContextMenu><MenuItem Header="恢复原主题" Click="AddRestore"/></ContextMenu></Button.ContextMenu>
          <Path Stroke="#49ABDF" StrokeThickness="1.5" Data="M0,6 H12 M6,0 V12" Width="12" Height="12"/>
        </Button>
      </StackPanel>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Text="正在准备" FontSize="18" Margin="0,0,0,14" TextWrapping="Wrap"/>
        <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" Background="#202020" BorderBrush="#414141" Foreground="#D9D9D9" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="12"/>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,12,0,0">
      <Button x:Name="StopButton" DockPanel.Dock="Left" Width="150" Content="停止（F8）" Click="Stop"/>
      <Button x:Name="RetryButton" DockPanel.Dock="Right" Width="100" Content="重试" Margin="12,0,0,0" Click="Retry"/>
      <TextBlock x:Name="SummaryText" Text="MaaFramework · 本地运行" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#B3B3B3"/>
    </DockPanel>
  </Grid>
</hc:Window>
