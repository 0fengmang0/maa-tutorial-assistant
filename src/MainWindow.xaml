<hc:Window x:Class="MaaTutorialAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="MAA 教程助手" Width="960" Height="680" MinWidth="860" MinHeight="560"
    WindowStartupLocation="CenterScreen" Background="#1C1C1C" Foreground="#EEEEEE"
    FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <hc:Window.Resources>
    <SolidColorBrush x:Key="MaaAccent" Color="#008DDB"/>
    <SolidColorBrush x:Key="MaaBorder" Color="#414146"/>
    <SolidColorBrush x:Key="MaaMuted" Color="#B3B3B3"/>
    <Geometry x:Key="TaskGear">M10,1 H14 L14.7,4.1 L16.1,4.7 L18.8,3.1 L21.6,5.9 L20,8.6 L20.6,10 H23 V14 H20.6 L20,15.4 L21.6,18.1 L18.8,20.9 L16.1,19.3 L14.7,19.9 L14,23 H10 L9.3,19.9 L7.9,19.3 L5.2,20.9 L2.4,18.1 L4,15.4 L3.4,14 H1 V10 H3.4 L4,8.6 L2.4,5.9 L5.2,3.1 L7.9,4.7 L9.3,4.1 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z</Geometry>
    <Style x:Key="TaskSelector" TargetType="RadioButton">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="RowBorder" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="2" Padding="4,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"/>
                <Path x:Name="Gear" Grid.Column="1" Data="{StaticResource TaskGear}" Width="18" Height="18"
                      Stretch="Uniform" Stroke="#888888" StrokeThickness="1.1" Fill="Transparent"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Gear" Property="Fill" Value="{StaticResource MaaAccent}"/>
                <Setter TargetName="Gear" Property="Stroke" Value="{StaticResource MaaAccent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#262626"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource MaaAccent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B3B3B3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#303034"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#292929"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#333333"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource MaaAccent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabFrame" Background="Transparent" BorderBrush="{StaticResource MaaBorder}" BorderThickness="1" Padding="6,2">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#009DEB"/>
                <Setter TargetName="TabFrame" Property="BorderBrush" Value="{StaticResource MaaAccent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#262626"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFrame" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,10,0,5"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="#1C1C1C"/>
      <Setter Property="Foreground" Value="#B3B3B3"/>
      <Setter Property="BorderBrush" Value="#303034"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </hc:Window.Resources>

  <Grid Margin="36,20,20,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/><ColumnDefinition Width="40"/>
      <ColumnDefinition Width="240"/><ColumnDefinition Width="40"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource MaaBorder}" BorderThickness="1" CornerRadius="4">
        <Grid Margin="10,12,10,10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox x:Name="TutorialCheck" IsChecked="True" VerticalAlignment="Center"
                        AutomationProperties.Name="启用通过 MAA 新手教程任务" Click="TaskEnabledChanged"/>
              <RadioButton x:Name="TutorialSelect" Grid.Column="1" GroupName="TaskDetails" IsChecked="True"
                           Style="{StaticResource TaskSelector}" Content="通过 MAA 新手教程" Click="SelectTask"
                           ToolTip="查看教程任务详情"/>
            </Grid>
            <Grid x:Name="RestoreRow" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox x:Name="RestoreCheck" VerticalAlignment="Center"
                        AutomationProperties.Name="启用恢复原主题任务" Click="TaskEnabledChanged"/>
              <RadioButton x:Name="RestoreSelect" Grid.Column="1" GroupName="TaskDetails"
                           Style="{StaticResource TaskSelector}" Content="恢复原主题" Click="SelectTask"
                           ToolTip="查看恢复原主题任务详情"/>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="AddButton" Style="{StaticResource FlatButton}" Click="AddTask"
                    ToolTip="添加任务" AutomationProperties.Name="添加任务">
              <Button.ContextMenu><ContextMenu><MenuItem x:Name="AddRestoreItem" Header="恢复原主题" Click="AddRestore"/></ContextMenu></Button.ContextMenu>
              <Grid Width="17" Height="17">
                <Ellipse Stroke="#888888" StrokeThickness="1"/>
                <Path Stroke="#888888" StrokeThickness="1" Data="M4,8.5 H13 M8.5,4 V13"/>
              </Grid>
            </Button>
            <Button x:Name="SelectAllButton" Grid.Column="1" Style="{StaticResource FlatButton}" Content="全选" Click="SelectAll"/>
            <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource FlatButton}" Content="清空" Click="ClearTasks" ToolTip="取消勾选全部任务"/>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="10,12,10,4">
        <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <TextBlock Text="完成后" HorizontalAlignment="Center"/>
        <Border BorderBrush="{StaticResource MaaBorder}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom"/>
        <TextBlock Grid.Row="1" Text="无动作" HorizontalAlignment="Center" VerticalAlignment="Center"
                   ToolTip="完成后保留 MAA 和助手窗口"/>
      </Grid>
      <Button x:Name="StartButton" Grid.Row="2" Style="{StaticResource FlatButton}" Content="开始"
              Width="108" Height="52" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="StartOrStop"
              ToolTip="执行勾选的任务；运行中按 F8 停止"/>
    </Grid>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
        <StackPanel>
          <StackPanel x:Name="TutorialDetails">
            <TextBlock Text="目标窗口" Style="{StaticResource FieldLabel}" Margin="8,2,0,5"/>
            <TextBox Style="{StaticResource FieldValue}" Text="自动查找已打开的 MAA"/>
            <TextBlock Text="教程语言" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource FieldValue}" Text="简体中文"/>
            <TextBlock Text="运行主题" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource FieldValue}" Text="深色"/>
            <TextBlock Text="任务状态" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TutorialStatus" Style="{StaticResource FieldValue}" Text="等待开始"/>
            <TextBlock Text="完成后主题" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ThemeAfterText" Style="{StaticResource FieldValue}" Text="保持深色"/>
          </StackPanel>
          <StackPanel x:Name="RestoreDetails" Visibility="Collapsed">
            <TextBlock Text="主题来源" Style="{StaticResource FieldLabel}" Margin="8,2,0,5"/>
            <TextBox Style="{StaticResource FieldValue}" Text="开始操作前自动记录"/>
            <TextBlock Text="恢复选项" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource FieldValue}" Text="原设置（含与系统同步）"/>
            <TextBlock Text="执行顺序" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource FieldValue}" Text="通过教程后执行"/>
            <TextBlock Text="任务状态" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RestoreStatus" Style="{StaticResource FieldValue}" Text="等待开始"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <UniformGrid Grid.Row="1" Columns="2">
        <RadioButton x:Name="GeneralTab" GroupName="DetailTabs" Style="{StaticResource Segment}" Content="常规设置"
                     IsChecked="True" Click="ChangeDetailTab"/>
        <RadioButton x:Name="AdvancedTab" GroupName="DetailTabs" Style="{StaticResource Segment}" Content="高级设置" Click="ChangeDetailTab"/>
      </UniformGrid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,12,8,0">
        <TextBlock x:Name="DetailHelpText" TextWrapping="Wrap" LineHeight="21"/>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Column="4">
      <UniformGrid Columns="2" Margin="0,0,0,5">
        <RadioButton x:Name="AllLogsTab" GroupName="LogTabs" Style="{StaticResource Segment}" Content="运行日志"
                     IsChecked="True" Click="ChangeLogTab"/>
        <RadioButton x:Name="TaskLogsTab" GroupName="LogTabs" Style="{StaticResource Segment}" Content="当前任务" Click="ChangeLogTab"/>
      </UniformGrid>
      <Border BorderBrush="{StaticResource MaaBorder}" BorderThickness="1" CornerRadius="4" MinHeight="100">
        <TextBox x:Name="LogText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource MaaMuted}" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" MinHeight="98" MaxHeight="350" Padding="8"
                 AutomationProperties.Name="任务运行日志"/>
      </Border>
      <Border BorderBrush="{StaticResource MaaBorder}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0" Padding="8">
        <TextBlock x:Name="StatusText" Text="等待开始" Foreground="{StaticResource MaaMuted}" TextWrapping="Wrap" LineHeight="20"/>
      </Border>
    </StackPanel>
  </Grid>
</hc:Window>
